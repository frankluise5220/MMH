POSTGRES_DB="mmh"
POSTGRES_USER="mmh-fs"
POSTGRES_PASSWORD="CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD"

DATABASE_URL="postgresql://mmh-fs:CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD@localhost:5433/mmh?schema=public"

LOCAL_AI_API_KEY="your-api-key"
LOCAL_AI_BASE_URL="http://localhost:11434/v1"
LOCAL_AI_MODEL_NAME="gpt-4o"

STATEMENT_API_KEY=""

# Web-triggered Docker updater. The install script generates MMH_UPDATE_TOKEN.
MMH_UPDATE_TOKEN=""
MMH_UPDATER_URL="http://updater:7788"
MMH_UPDATER_IMAGE="ghcr.io/frankluise5220/mmh-updater:latest"
MMH_COMPOSE_PROJECT="mmh"

# Signed login session secret. The Docker entrypoint generates a persistent
# value when this is empty; set a 32+ character random value for manual
# production deployments.
MMH_SESSION_SECRET=""

# External MMH registration service (mmh-registration). Registering a user binds
# an email login identity in the central service and returns a principalId.
# Leave MMH_REGISTRATION_API_TOKEN empty to disable the feature; both the URL
# and the token must be set for registration to work. The token is a bearer
# token issued by the mmh-registration deployment (REGISTRATION_API_TOKEN).
# The public entry is the TLS reverse proxy on 10101 (server_name
# fnapp.floatingice.win); 8790 is bound to 127.0.0.1 only and is not reachable
# from other hosts.
MMH_REGISTRATION_API_URL="https://fnapp.floatingice.win:10101"
MMH_REGISTRATION_API_TOKEN=""

# Ledger inventory reporting to the registration service (same URL/token above).
# Each deployment sends one snapshot at most every 6 hours, plus one right after
# a user is bound to an MMH account or a ledger is created/deleted. This is what
# lets the central service answer "this MMH account is bound to N ledgers with M
# members". Only ids and counts are sent: never ledger names, member names,
# emails or any amount. Set to 1 to keep the inventory entirely local.
MMH_INSTALLATION_REPORT_DISABLED="0"

# Verification-code mail relay. Instead of calling api.resend.com directly, MMH
# sends { to, code, expiresMinutes } to the project's own mail server, which
# relays it through local Postfix (fixed sender mmh@floatingice.win). Set both
# to enable; the token is issued by the relay server and never carries passwords
# or SMTP credentials.
MMH_MAIL_RELAY_URL="https://admin.floatingice.win"
MMH_MAIL_RELAY_TOKEN=""

PASSWORD_RESET_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# System-level scheduled task runner (src/instrumentation.ts).
# Materializes due credit-card installment payments for all households on an
# interval. Default 10 minutes; set MMH_SYSTEM_TASKS_DISABLED=1 to turn off.
MMH_SYSTEM_TASK_INTERVAL_MS="600000"
MMH_SYSTEM_TASKS_DISABLED="0"

# Auto-execute (startup catch-up) runs in rounds until no plan is due, so
# multiple missed periods (installments, loan repayments, regular invest) are
# all generated when the app is opened. Cap the rounds to bound a pathological
# run. Default 12.
MMH_AUTO_EXECUTE_MAX_ROUNDS="12"

# Security hardening:
# - Production HTTPS cookies are Secure by default. Plain HTTP requests use non-Secure cookies so trusted LAN deployments can log in.
# - Set MMH_INSECURE_COOKIES=1 only if a trusted HTTP proxy makes the app unable to detect the original request protocol.
# - Enable HSTS only after confirming the public site is always served through HTTPS.
MMH_INSECURE_COOKIES="0"
MMH_ENABLE_HSTS="0"
# Optional app-level Host allowlist. Empty means allow any Host header.
# Use this when exposing MMH through fixed domains or reverse proxy hosts.
# Example: MMH_ALLOWED_HOSTS="mmh.example.com,192.168.1.100,localhost,127.0.0.1"
MMH_ALLOWED_HOSTS=""

RESEND_API_KEY=""
RESEND_FROM="onboarding@resend.dev"

# Project feedback-only Resend key. Only the feedback API reads this value.
# Do not use it for password reset, email tests, or user-configured mail.
MMH_FEEDBACK_RESEND_API_KEY=""
MMH_FEEDBACK_RESEND_FROM="mmh@floatingice.win"

# Optional project feedback relay. Leave unset to use the built-in relay.
# Set to an empty value to disable the relay fallback for a private deployment.
# MMH_FEEDBACK_RELAY_URL="https://feedback.floatingice.win/v1/feedback"

SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

PRISMA_CLIENT_ENGINE_TYPE="binary"

# Git update config (optional; defaults to origin/main of the current repo)
# MMH_GIT_REMOTE="origin"
# MMH_GIT_BRANCH="main"
# MMH_UPDATE_SOURCE_URL="https://github.com/frankluise5220/MMH.git"

# Docker image config (optional). Users can change this in System Update.
# Host port exposed by Docker. The app always listens on container port 7777.
# Change this to 7780 (for example) when the NAS host port 7777 is occupied.
MMH_HOST_PORT="7777"
# MMH_IMAGE_SOURCE: auto | ghcr | dockerproxy | nju | daocloud | custom
MMH_IMAGE_SOURCE="auto"
MMH_APP_IMAGE="ghcr.io/frankluise5220/mmh:latest"
MMH_UPDATER_IMAGE="ghcr.io/frankluise5220/mmh-updater:latest"
CUSTOM_MMH_APP_IMAGE=""
CUSTOM_MMH_UPDATER_IMAGE=""

# Update rollback: before pulling images the updater dumps the database (pg_dump)
# and rolls the app AND the database back together when an update fails. Set this
# to 1 only when the host cannot produce a database snapshot (e.g. a custom
# database image without the client tools); with it set, a failed update restores
# the app only and the older image may be refused by the schema version guard.
# MMH_UPDATE_ALLOW_NO_SNAPSHOT="1"
# If GHCR is slow from your network, use one mirror/proxy instead:
# MMH_APP_IMAGE="ghcr.dockerproxy.net/frankluise5220/mmh:latest"
# MMH_UPDATER_IMAGE="ghcr.dockerproxy.net/frankluise5220/mmh-updater:latest"
# MMH_APP_IMAGE="ghcr.m.daocloud.io/frankluise5220/mmh:latest"
# MMH_UPDATER_IMAGE="ghcr.m.daocloud.io/frankluise5220/mmh-updater:latest"
# MMH_APP_IMAGE="ghcr.nju.edu.cn/frankluise5220/mmh:latest"
# MMH_UPDATER_IMAGE="ghcr.nju.edu.cn/frankluise5220/mmh-updater:latest"
NODE_IMAGE="node:20-bookworm"
NODE_BUILD_IMAGE="node:20-bookworm"
NODE_RUNTIME_IMAGE="node:20-bookworm"
POSTGRES_IMAGE="postgres:15-alpine"
