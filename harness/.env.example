# ============================================================================
# MMH Bug Harness —— 首次启动的默认值 / 环境变量入口
#
# ⚠ 配置优先级（逐键）：data/config.json  >  本文件（或容器环境变量）  >  代码默认值
#   也就是说：**在配置页面上保存过的项，会覆盖这里**。
#   日常改配置请直接用配置页（浏览器打开 http://127.0.0.1:7788/），
#   本文件只在「首次启动种子」和「gitops 硬编码」两种场景下有意义。
#   想清掉页面覆盖，在页面上点「清除页面覆盖」即可。
# ============================================================================

# ---- 访问控制 ----
# 页面登录密码。初始值 mmh12345，登录后请在配置页改成自己的。
# 填 "-" = 关闭登录（只建议在端口绑回环时这样）。
# 改密码后所有已登录的浏览器会被登出（会话令牌由密码派生）。
# 也可以在配置页面上直接设置（无需重启）。
HARNESS_UI_PASSWORD=mmh12345

# ---- 运行时 ----
# 健康检查 / 状态 HTTP 端口（容器内），对外映射见 docker-compose.yml
HARNESS_PORT=7788
# 轮询间隔（毫秒）。默认 5 分钟。
HARNESS_POLL_INTERVAL_MS=300000
# 首次运行策略：backfill = 把当前已存在的 open issue / 未读反馈邮件全部生成任务；
#               now      = 只处理服务启动之后的新活动。
HARNESS_FIRST_RUN=backfill
# true 时只打印将要生成的任务，不写文件、不改状态库（用于首次验证）。
HARNESS_DRY_RUN=false
# debug | info | warn | error
HARNESS_LOG_LEVEL=info
# 渲染进任务 front-matter 的工作区提示（第三方 harness 在哪份 MMH 检出上改代码）
HARNESS_WORKSPACE_HINT=

# ---- 数据目录（容器内路径，由 volume 挂载）----
HARNESS_DATA_DIR=/data
HARNESS_TASKS_DIR=/tasks

# ---- GitHub ----
# 细粒度 PAT，至少需要仓库的 Issues: Read 权限。
# 公开仓库可以留空（走匿名访问，限 60 次/小时，轮询间隔建议 >= 10 分钟）；私有仓库必填。
GITHUB_TOKEN=
GITHUB_REPO=frankluise5220/MMH
GITHUB_API_BASE=https://api.github.com
# 只处理带这些标签的 issue（逗号分隔）。留空 = 全部 open issue。
GITHUB_LABELS=
# 每个 issue 抓取最近 N 条评论作为上下文。
GITHUB_COMMENTS_MAX=10

# ---- IMAP（MMH 反馈邮箱）----
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
# 只处理主题含这些前缀的邮件（逗号分隔）。默认 [MMH Bug]。
# MMH 反馈邮件前缀：[MMH Bug] / [MMH Feedback] / [MMH Sponsor Tip]
# 想连建议一起收：[MMH Bug],[MMH Feedback]   想全部收：*
IMAP_SUBJECT_FILTER=[MMH Bug]
# 处理后是否标记为已读。
IMAP_MARK_SEEN=true

# ---- 模型（OpenAI 兼容端点）----
# 例：https://api.deepseek.com/v1  /  https://api.siliconflow.cn/v1  /  http://192.168.2.x:1234/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=120000
# 单次运行最多调用模型的条目数（防止首次 backfill 打爆额度）。
AI_MAX_CALLS_PER_CYCLE=10
