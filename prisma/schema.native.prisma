  updatedAt      DateTime  @default(now()) @updatedAt

  @@unique([householdId, code])
  @@index([householdId])
}

/// 债券交易（买入 / 赎回 / 利息到账 / 核销）。对齐 DepositTransaction，
/// 不含基金专属的 units / nav。
///
/// 存单粒度：买入行本身就是一张「存单」（一个持仓），同一债单可以有多张存单；
/// 付息/赎回/核销等子行用 sourceBondTransactionId 指回所属存单。条款（到期日/
/// 期限/付息方式/首次付息日/计息基础）落在存单上，付息因此按存单各自产生。
model BondTransaction {
  id                      String              @id @default(cuid())
  householdId             String
  accountId               String
  cashAccountId           String?
  cashEntryId             String?             @unique
  bondProductId           String?
  productName             String?
  /// 所属存单（= 该债单买入行的 id）；买入行为 null，子行必填。
  sourceBondTransactionId String?
  action                  FundSubtype         @default(buy)
  /// 品种：bond = 债券（默认）；repo = 国债逆回购。
  /// 逆回购复用同一套「存单」语义（借出 = buy 行、到期回款 = redeem 子行），
  /// 但不进债券产品库、不生成付息计划，视图与明细都按这一列分流。
  instrumentKind          String              @default("bond")
  source                  String?             @default("manual")
  entryOrigin             String?             @default("manual")
  tradeDate               DateTime
  confirmDate             DateTime?
  arrivalDate             DateTime?
  /// 存单条款快照：缺省时回退债单主数据（BondProduct）的同名字段。
  termDays                Int?
  maturityDate            DateTime?
  payoutFrequency         String?
  firstPayoutDate         DateTime?
  interestCalcBasis       String?
  grossAmount             Decimal
  arrivalAmount           Decimal?
  interest                Decimal?
  fee                     Decimal?
  annualRate              Decimal?
  realizedProfit          Decimal?
  note                    String?
  deletedAt               DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @default(now()) @updatedAt
  Account                 Account             @relation("BondTransaction_account", fields: [accountId], references: [id], onDelete: Cascade)
  CashAccount             Account?            @relation("BondTransaction_cashAccount", fields: [cashAccountId], references: [id], onDelete: SetNull)
  Household               Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  BondProduct             BondProduct?        @relation(fields: [bondProductId], references: [id], onDelete: SetNull)
  SourceBondTransaction   BondTransaction?    @relation("BondTransaction_source", fields: [sourceBondTransactionId], references: [id], onDelete: SetNull)
  ChildTransactions       BondTransaction[]   @relation("BondTransaction_source")
  EntryBusinessLink       EntryBusinessLink[]

  @@index([householdId, accountId, tradeDate])
  @@index([cashAccountId, tradeDate])
  @@index([bondProductId, tradeDate])
  @@index([sourceBondTransactionId])
  @@index([deletedAt])
  @@map("bond_transactions")
}

