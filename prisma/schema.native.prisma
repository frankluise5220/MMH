  @@index([settlementId])
  @@map("reimbursement_settlement_transactions")
}

model ReimbursementItem {
  id                     String                    @id @default(cuid())
  reimbursementId        String
  txRecordId             String?                   @unique
  advanceAccountId       String?
  amount                 Decimal
  outsideTransportAmount Decimal?
  cityTransportAmount    Decimal?
  subsidyAmount          Decimal?
  lodgingAmount          Decimal?
  days                   Int?
  entryDate              DateTime
  categoryName           String?
  expenseItem            ReimbursementExpenseItem?
  fromPlace              String?
  toPlace                String?
  vehicle                String?
  note                   String?
  invoiceCode            String?
  invoiceNumber          String?
  invoiceAmount          Decimal?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @default(now()) @updatedAt
  Reimbursement          Reimbursement             @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)

  @@index([advanceAccountId])
  @@index([reimbursementId])
  @@map("reimbursement_items")
}

model TxRecord {
  id                                  String                               @id @default(cuid())
  date                                DateTime
  postedAt                            DateTime?
  type                                TransactionType
  amount                              Decimal
  accountId                           String
  accountName                         String
  toAccountId                         String?
  toAccountName                       String?
  categoryId                          String?
  categoryName                        String?
  fundCode                            String?
  fundProductType                     FundProductType?
  metalTypeId                         String?
  metalTypeName                       String?
  metalUnitId                         String?
  metalUnitName                       String?
  metalQuantity                       Decimal?
  metalUnitPrice                      Decimal?
  metalFee                            Decimal?
  confirmDate                         DateTime?
  statementMonth                      String?
  note                                String?
  toNote                              String?
  deletedAt                           DateTime?
  importBatchId                       String?
  householdId                         String?
  createdAt                           DateTime                             @default(now())
  updatedAt                           DateTime                             @default(now()) @updatedAt
  dayOrder                            Int                                  @default(0)
  currency                            String                               @default("CNY")
  paymentChannelId                    String?
  paymentChannelName                  String?
  counterpartyInstitutionId           String?
  counterpartyInstitutionName         String?
  status                              TransactionStatus                    @default(posted)
  fundArrivalAmount                   Decimal?
  fundArrivalDate                     DateTime?
  depositAnnualRate                   Decimal?
  depositInterest                     Decimal?
  depositSourceEntryId                String?
  depositMaturityAction               String?
  depositInterestPayoutFrequency      String?
  depositInterestCalcBasis            String?
  fundSourceEntryId                   String?
  principalAmount                     Decimal?
  interestAmount                      Decimal?
  feeAmount                           Decimal?
  fundConfirmDate                     DateTime?
  fundFee                             Decimal?
  // 债券专用字段：债券不再复用 fund* / deposit* 字段承载语义
  bondProductId                       String?
  bondSubtype                         FundSubtype?
  bondName                            String?
  bondAnnualRate                      Decimal?
  bondInterest                        Decimal?
  bondArrivalDate                     DateTime?
  bondConfirmDate                     DateTime?
  bondFee                             Decimal?
  fundNav                             Decimal?
  fundSubtype                         FundSubtype?
  fundUnits                           Decimal?
  realizedProfit                      Decimal?
  regularInvestPlanId                 String?
  creditCardInstallmentPlanId         String?
  installmentNo                       Int?
  installmentTotal                    Int?
  installmentPrincipal                Decimal?
  installmentInterest                 Decimal?
  installmentRole                     String?
  fundName                            String?
  wealthProductId                     String?
  depositProductId                    String?
  insuranceProductId                  String?
  insuranceAction                     String?
  insuranceProductName                String?
  source                              String?                              @default("manual")
  reimbursementDifferenceAmount       Decimal?
  reimbursementDifferenceCategoryName String?
  entryOrigin                         String?                              @default("manual")
  originalCurrency                    String?
  originalAmount                      Decimal?
  // 券 / 包（红包、优惠券等）抵扣金额：记主交易时界面填「消费总额」，
  // 主交易 amount 只记实付（消费总额 − 券包）。只有转账 / 代付才另生成一条
  // income 分录（source=voucher，voucherSourceEntryId 指回本条主交易）记到
  // 收款账户，用于两边分别记总额与实付；纯支出只记实付，不生成券包收入。
  voucherAmount                       Decimal?
  voucherSourceEntryId                String?
  locationId                          String?
  locationName                        String?
  // 对账锁定：reconciledAt 非空表示该记录已「对账」——不可删除、不可修改（编辑窗只读），
  // 只有解除对账才能再改。reconciledBalance 是对账当时钉住的「本行事后余额」，
  // 在余额折叠里作为锚点（等价于「余额校准」）：它之前的流水变化不再影响它及之后的行。
  reconciledAt                        DateTime?
  reconciledBalance                   Decimal?
  Attachment                          Attachment[]
  EntryTag                            EntryTag[]
  account                             Account                              @relation("transactions_accountIdToAccount", fields: [accountId], references: [id])
  Category                            Category?                            @relation(fields: [categoryId], references: [id])
  Household                           Household?                           @relation(fields: [householdId], references: [id])
  ImportBatch                         ImportBatch?                         @relation(fields: [importBatchId], references: [id])
  InsuranceProduct                    InsuranceProduct?                    @relation(fields: [insuranceProductId], references: [id], onDelete: SetNull)
  WealthProduct                       WealthProduct?                       @relation(fields: [wealthProductId], references: [id], onDelete: SetNull)
  BondProduct                         BondProduct?                         @relation(fields: [bondProductId], references: [id], onDelete: SetNull)
  DepositProduct                      DepositProduct?                      @relation(fields: [depositProductId], references: [id], onDelete: SetNull)
  PreciousMetalType                   PreciousMetalType?                   @relation(fields: [metalTypeId], references: [id], onDelete: SetNull)
  PreciousMetalUnit                   PreciousMetalUnit?                   @relation(fields: [metalUnitId], references: [id], onDelete: SetNull)
  toAccount                           Account?                             @relation("transactions_toAccountIdToAccount", fields: [toAccountId], references: [id])
  CreditCardInstallmentPlan           CreditCardInstallmentPlan?           @relation("CreditCardInstallmentEntries", fields: [creditCardInstallmentPlanId], references: [id], onDelete: Cascade)
  CreditCardInstallmentSource         CreditCardInstallmentPlan[]          @relation("CreditCardInstallmentSource")
  EntryBusinessLinkCash               EntryBusinessLink[]                  @relation("EntryBusinessLink_cashEntry")
  EntryBusinessLinkBusiness           EntryBusinessLink[]                  @relation("EntryBusinessLink_businessEntry")
  FxConversionFromEntry               FxConversion?                        @relation("FxConversion_fromEntry")
  FxConversionToEntry                 FxConversion?                        @relation("FxConversion_toEntry")
  ReimbursementSettlementTransactions ReimbursementSettlementTransaction[]
  ReimbursementPayments               Reimbursement[]                      @relation("ReimbursementPaymentTx")

  @@index([accountId, date])
  @@index([accountId, date, dayOrder])
  @@index([accountId, postedAt])
  @@index([accountId, statementMonth])
  @@index([counterpartyInstitutionId])
  @@index([deletedAt])
  @@index([depositSourceEntryId])
  @@index([fundSourceEntryId])
  @@index([insuranceProductId])
  @@index([wealthProductId])
  @@index([bondProductId])
  @@index([depositProductId])
  @@index([metalTypeId])
  @@index([metalUnitId])
  @@index([regularInvestPlanId])
  @@index([creditCardInstallmentPlanId, installmentNo])
  @@index([toAccountId, fundProductType])
  @@index([toAccountId, date, dayOrder])
  @@index([type])
  @@map("transactions")
}

model FxConversion {
