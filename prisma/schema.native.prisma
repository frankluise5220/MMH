  date          DateTime
  householdId   String
  fromEntryId   String   @unique
  toEntryId     String   @unique
  fromAccountId String
  toAccountId   String
  fromCurrency  String
  toCurrency    String
  fromAmount    Decimal
  toAmount      Decimal
  exchangeRate  Decimal
  feeAmount     Decimal?
