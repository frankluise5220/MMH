model ApprovedCurrency {
  id        String   @id @default(cuid())
  code      String   @unique // ISO 4217 code, e.g. "KRW", "SGD"
  nameZh    String // 中文名称
  nameEn    String // English name
  countryZh String? // 中文国家名（用于自动联想）
  countryEn String? // English country name
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  createdBy String? // userId of the approver
}

model CustomCurrencyRequest {
  id           String                      @id @default(cuid())
  code         String // ISO 4217 code, e.g. "KRW"
  nameZh       String // 用户填写的中文名称
  nameEn       String // 用户填写的英文名称
  countryZh    String // 用户填写的中文国家名
  countryEn    String?
  status       CustomCurrencyRequestStatus @default(pending)
  requesterId  String // userId of the requester
  householdId  String? // optional household context
  approverId   String?
  rejectReason String?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @default(now()) @updatedAt

  @@index([status])
  @@index([requesterId])
  @@index([code])
}

enum CustomCurrencyRequestStatus {
  pending
  approved
  rejected
}

// Schema version marker for the Docker entrypoint downgrade protection.
// Declared here (not only via entrypoint DDL) because "prisma db push"
// silently drops tables it does not own; in 0.1.60-0.1.63 the DDL-only
// table was dropped on every boot, disabling downgrade protection for
// every Docker database.
model MmhSchemaMeta {
  key   String @id
  value String

  @@map("_mmh_schema_meta")
}
