  Household        Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, advanceAccountId, createdAt])
  @@map("reimbursement_batches")
}

model ReimbursementTransaction {
  id              String        @id @default(cuid())
  reimbursementId String
  txRecordId      String        @unique
  createdAt       DateTime      @default(now())
  Reimbursement   Reimbursement @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)

  @@index([reimbursementId])
  @@map("reimbursement_transactions")
}

model ReimbursementSettlement {
  id              String                               @id @default(cuid())
  reimbursementId String
