  name                   String
  shortName              String?
  productMasterId        String?
  productType            InsuranceProductType    @default(other)
  accountingType         InsuranceAccountingType @default(asset)
  policyNo               String?
  status                 InsuranceStatus         @default(active)
  currency               String                  @default("CNY")
  householdId            String
  accountId              String
  institutionId          String?
  ownerGroupId           String?
  policyholderPersonId   String?
  insuredUserId          String?
  insuredPersonId        String?
  beneficiaryName        String?
  startDate              DateTime?
  effectiveDate          DateTime?
  maturityDate           DateTime?
  premiumMode            String?
  premiumFrequencyMonths Int?
  premiumAmount          Decimal?
  paymentTermYears       Decimal?
  coverageTermYears      Decimal?
  coverageAmount         Decimal?
  cashValueEnabled       Boolean                 @default(true)
  note                   String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @default(now()) @updatedAt
  ProductMaster          InsuranceProductMaster? @relation(fields: [productMasterId], references: [id], onDelete: SetNull)
  Account                Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  Household              Household               @relation(fields: [householdId], references: [id], onDelete: Cascade)
  Institution            Institution?            @relation("InsuranceProductInsurer", fields: [institutionId], references: [id], onDelete: SetNull)
  OwnerGroup             AccountGroup?           @relation(fields: [ownerGroupId], references: [id], onDelete: SetNull)
  PolicyholderPerson     Institution?            @relation("InsuranceProductPolicyholder", fields: [policyholderPersonId], references: [id], onDelete: SetNull)
  InsuredUser            User?                   @relation("InsuranceProduct_insuredUserIdToUser", fields: [insuredUserId], references: [id], onDelete: SetNull)
  InsuredPerson          Institution?            @relation("InsuranceProductInsured", fields: [insuredPersonId], references: [id], onDelete: SetNull)
