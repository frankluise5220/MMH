/// 账簿级显示/行为设置。**这里是唯一真源**；浏览器 cookie 只是它的读缓存
/// （客户端组件需要同步读取，才不必把 20 多个组件改成异步）。
/// 判断标准：凡是「设置页里用户能选、并且服务端也可能读到」的项，都放这里。
/// 反例：侧边栏折叠态、导航按钮偏移、侧边栏 owner 过滤——那是设备和会话的
/// 瞬时 UI 状态，入库反而会让多设备互相覆盖。
model HouseholdPreference {
  householdId                       String          @id
  sessionDays                       Int             @default(30)
  fundUnitsDecimals                 Int             @default(2)
  aiPanelEnabled                    Boolean         @default(true)
  /// IANA 时区名。业务日（今天/本月/本年）与时刻格式化都读它。
  timeZone                          String          @default("Asia/Shanghai")
  colorScheme                       String          @default("red_up_green_down")
  creditCardLabelMode               String          @default("short_last4")
  /// 为空表示「按 mode 推导默认模板」，不是「空模板」。
  creditCardLabelTemplate           String?
  creditCardSidebarLabelTemplate    String?
  creditBillHideZero                Boolean         @default(false)
  creditBillHideSettled             Boolean         @default(false)
  creditBillShowRecentCycles        Boolean         @default(true)
  displayLanguage                   String          @default("zh-CN")
  dateDisplayFormat                 String          @default("yyyy-mm-dd")
  sidebarGroupBy                    String          @default("kind")
  // 账户下拉的分组维度（2026-11-13）：owner（按所有人，默认 / 历史行为）|
  // accountGroup（按账户自定义分组标签）| institution（按机构）。
  // 与 sidebarGroupBy 是两套独立设置：下拉表头原本固定按所有人，侧边栏则是 类型/机构。
  accountDropdownGroupBy            String          @default("owner")
  sidebarHideZero                   Boolean         @default(false)
  sidebarHideInitialData            Boolean         @default(false)
  sidebarShowFixedAssets            Boolean         @default(true)
  sidebarShowAllCashEntries         Boolean         @default(true)
  sidebarShowReimbursements         Boolean         @default(true)
  /// 合并账单（同机构 + 同所有人）的信用卡在侧边栏折叠成一条「机构·信用卡」。
  sidebarMergeConsolidatedCreditCards Boolean       @default(false)
  detailDateBackground              Boolean         @default(false)
  /// 明细默认观测窗口（年）。0 = 不限（全部时间）。「全部」视图与首屏都按它裁数据。
  detailWindowYears                 Int             @default(5)
  rowHeightMode                     Int             @default(35)
  /// account-display 的版本化序列化串；为空表示未配置，用默认字段集。
  accountLabelFields                String?
  accountDropdownRestrictType       Boolean         @default(true)
  /// 侧边栏 / 账户下拉是否按最近一个月的记账频率排序；关闭后保持账户原始顺序。
  accountUsageSortEnabled           Boolean         @default(true)
  /// 逆回购占款天数口径（决定预计利息怎么算）：
  /// actual      = 成交日 → 回款日的自然日差，与券商实付一致（周五做 1 天期 = 3 天）；
  /// term        = 只按品种期限，顺延回款不加天（1 天期永远 1 天）；
  /// arrival_gap = 品种期限 + 回款日之后到下个交易日的休市天数（回款日落在周五则 +2）。
  repoOccupiedDaysMode              String          @default("actual")
  createdAt                         DateTime        @default(now())
  updatedAt                         DateTime        @default(now()) @updatedAt

  Household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

