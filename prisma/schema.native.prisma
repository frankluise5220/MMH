  @@index([householdId, accountingType])
  @@index([accountId])
  @@index([institutionId])
  @@index([ownerGroupId])
  @@index([policyholderPersonId])
  @@index([insuredUserId])
  @@index([insuredPersonId])
}

model Reimbursement {
  id                 String                     @id @default(cuid())
  batchId            String?
  householdId        String
  advanceAccountId   String?
  documentNumber     String?
  title              String
  counterpartyId     String
  counterpartyName   String
  status             ReimbursementStatus        @default(pending)
  kind               ReimbursementKind          @default(advance)
  totalAmount        Decimal
  approvedAmount     Decimal?
  approvalDate       DateTime?
  approvalNote       String?
  travelStartDate    DateTime?
  travelEndDate      DateTime?
  travelReason       String?
  attachmentCount    Int?
  reimbursedDate     DateTime?
  cashAccountId      String?
  cashAccountName    String?
  paymentTxRecordId  String?                    @unique
  note               String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @default(now()) @updatedAt
  deletedAt          DateTime?
  items              ReimbursementItem[]
  linkedTransactions ReimbursementTransaction[]
  settlements        ReimbursementSettlement[]
  PaymentTxRecord    TxRecord?                  @relation("ReimbursementPaymentTx", fields: [paymentTxRecordId], references: [id], onDelete: SetNull)
  Batch              ReimbursementBatch?        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  Household          Household                  @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, status])
  @@index([householdId, counterpartyId, status])
  @@index([householdId, advanceAccountId, status])
  @@index([batchId])
  @@map("reimbursements")
}

model ReimbursementBatch {
  id               String          @id @default(cuid())
  householdId      String
  advanceAccountId String
