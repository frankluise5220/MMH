model User {
  id                      String               @id @default(cuid())
  name                    String
  email                   String?
  role                    String               @default("admin")
  isSystem                Boolean              @default(false)
  passwordHash            String?
  authVersion             Int                  @default(1)
  /// principalId issued by the external mmh-registration service (registration identifier)
  registrationPrincipalId String?
  /// MMH membership address captured when the binding was made. Deliberately
  /// separate from `email`: that one is the editable local contact field and
  /// can be changed afterwards, which must not lose track of the bound account.
  registrationEmail      String?
  /// fnOS user UID / FN ID bound to this user, unique within its ledger (one UID per ledger)
  fnosUid                 String?
  householdId             String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @default(now()) @updatedAt
  Account                 Account[]
  Household               Household?           @relation(fields: [householdId], references: [id])
  InsuranceProduct        InsuranceProduct[]   @relation("InsuranceProduct_insuredUserIdToUser")
  SponsorTipIntent        SponsorTipIntent[]
  UserSettings            UserSettings?
  PasswordResetToken      PasswordResetToken[]

  @@unique([householdId, fnosUid])
  @@index([email])
}

model SponsorTipIntent {
  id          String     @id @default(cuid())
  userId      String
  householdId String?
  email       String
  amount      Decimal
  status      String     @default("pending")
  claimedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
  User        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  Household   Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([householdId, createdAt])
  @@index([email])
}

