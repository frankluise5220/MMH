/// 债券（城投债 / 国债）产品主数据。债券不是基金，也不是普通理财：
/// 有自己的条款字段（票面利率、到期日、付息方式、计息基础、首次付息日），
/// 不复用 WealthProduct / fund* 字段。
model BondProduct {
  id                String            @id @default(cuid())
  name              String
  shortName         String?
  currency          String            @default("CNY")
  annualRate        Decimal?
  termDays          Int?
  // 债券条款：到期日、付息方式（编码同存款：maturity | yearly(:N) | monthly(:N)）、计息基础、首次付息日锚点
  maturityDate      DateTime?
  payoutFrequency   String?
  interestCalcBasis String?
  firstPayoutDate   DateTime?
  note              String?
  isActive          Boolean           @default(true)
  householdId       String
  institutionId     String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt
  Household         Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  Institution       Institution?      @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  TxRecord          TxRecord[]
  BondTransaction   BondTransaction[]

  @@unique([householdId, institutionId, name])
  @@index([householdId, isActive, name])
  @@index([institutionId])
}

/// 逆回购自定义品种：交易所 GC/R- 静态清单（src/lib/repo.ts，不入库）之外的品种，
