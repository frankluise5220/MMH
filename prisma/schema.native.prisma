/// 固定资产折旧台账（2026-11-18 用户裁定）。
///
/// 两种来源共用一张表，靠 `method` 区分：
/// - `straight_line`：设定直线法后系统按**月**自动生成：金额恒定 =
///   （成本 − 残值）÷ 折旧月数，从购入月起补记到当前月；年折旧率 = 1/年限
///   （10 年报废 = 每年 10%）。
/// - `manual`：用户手工登记的折损 / 减值（一次性折完也走这里：登记一笔全额）。
///   手工记录的 `periodMonth` 存**所属月最后一天**，这样同一月既有自动计提又有
///   手工登记时不会撞 @@unique(propertyAssetId, periodMonth)；展示仍按 YYYY-MM。
///   手工合计同步到 PropertyAsset.accumulatedDepreciation（none 模式它就是累计折旧，
///   straight_line 模式下它就是「额外折损」）。
///
/// 处置/售出时以台账定格：自动部分取 straight_line 累计，手工部分取资产字段。
///
/// 折旧是**账面价值减少**，不是现金支出：本表不产生 TxRecord、不改账户余额、
/// 不进收支报表。口径实现见 src/lib/fixed-asset-depreciation.ts 与
/// src/lib/server/property-depreciation.ts。
model PropertyAssetDepreciation {
  id                String        @id @default(cuid())
  householdId       String
  propertyAssetId   String
  /// 计提所属月：自动记录 = 该月 1 日、手工记录 = 该月最后一天（均 UTC 零点，date-only 契约）。
  periodMonth       DateTime
  /// 本期折旧额。
  amount            Decimal
  /// 计提后的累计折旧（自动部分封顶可折旧基数；手工部分封顶成本）。
  accumulatedAfter  Decimal
  /// 计提时冻结的口径快照，便于审计（成本 / 残值 / 折旧月数）。
  basisCost         Decimal
  basisSalvage      Decimal
  basisMonths       Int
  method            String        @default("straight_line")
  /// 手工登记时的说明（自动计提为空）。
  note              String?
  createdAt         DateTime      @default(now())
  Household         Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  PropertyAsset     PropertyAsset @relation(fields: [propertyAssetId], references: [id], onDelete: Cascade)

  @@unique([propertyAssetId, periodMonth])
  @@index([householdId, periodMonth])
  @@map("property_asset_depreciations")
}

