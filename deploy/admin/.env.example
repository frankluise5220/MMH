# MMH 后台管理 —— 环境变量
# 复制成 .env（chmod 600）后按实际部署改。install.sh 会自动生成 ADMIN_TOKEN。

# ==================== 服务 ====================
# 只监听回环；对外由 nginx 的 admin.floatingice.win 反代
BIND_HOST=127.0.0.1
BIND_PORT=8791

# 登录口令。留空则 install.sh 随机生成 32 字节 hex。
# 轮换它会自动让所有已登录会话失效（cookie 签名密钥由它派生）。
ADMIN_TOKEN=

# 会话有效期（秒），默认 7 天
SESSION_TTL=604800

# ==================== 容器内路径（一般不用改）====================
DATA_DIR=/data
STATS_DB_DIR=/var/lib/mmh-fnstore
REG_DB=/var/lib/mmh-registration/registration.sqlite3
VMAIL_ROOT=/var/vmail/floatingice.win
GITHUB_TOKEN_FILE=/etc/mmh-admin/github-token

# ==================== 宿主路径（挂载源，按实际部署改）====================
HOST_DATA_DIR=/opt/mmh-admin/data
HOST_FNSTORE_DATA=/opt/fn-appstores-server/data
HOST_REGISTRATION_DATA=/opt/mmh-registration/data
HOST_VMAIL_ROOT=/var/vmail/floatingice.win
HOST_GITHUB_TOKEN_DIR=/etc/mmh-admin

# ==================== 邮件 ====================
# 要盯的信箱，逗号分隔；留空 = 自动发现 VMAIL_ROOT 下所有信箱
MAIL_ACCOUNTS=mmh,sink
MAIL_FROM=mmh@floatingice.win
MAIL_FROM_NAME=MMH
# 本机 Postfix（host 网络下就是 127.0.0.1）
SMTP_HOST=127.0.0.1
SMTP_PORT=25

# ==================== GitHub ====================
GITHUB_REPO=frankluise5220/MMH
# 允许操作的仓库白名单，防止 token 被拿去改别的仓库
GITHUB_ALLOWED_REPOS=frankluise5220/MMH

# ==================== 时区 ====================
# 后台时间显示的口径。IANA 名（Asia/Shanghai）或固定偏移（UTC+8）都行。
# 这只是默认值：在「设置」页改过之后以 DATA_DIR/tz 文件为准，且不用重启容器。
# 注意 stats_store.py 里下载时间写死 CST（要和 fnstore 页面口径一致），不跟着变。
TZ_SPEC=Asia/Shanghai

# ==================== 其它 ====================
STATS_DEFAULT_DAYS=30
ADMIN_IMAGE=python:3.11-slim
