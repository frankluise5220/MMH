COMPOSE_PROJECT_NAME="mmh"
POSTGRES_DB="mmh"
POSTGRES_USER="mmh-fs"
POSTGRES_PASSWORD="CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD"
STATEMENT_API_KEY=""
# 网页更新令牌：应用与更新器容器的共享口令（必填，网页“系统更新”依赖它）。
# 生成示例：openssl rand -hex 24。不设置时网页更新不可用。
# 旧版 docker-compose.yml 由 POSTGRES_PASSWORD 派生该令牌，无需设置。
MMH_UPDATE_TOKEN=""
MMH_SESSION_SECRET=""
MMH_UPDATER_URL="http://updater:7788"
# NAS runtime guardrails: cap abnormal growth, report pressure in /api/health, and leave normal workloads room.
MMH_APP_MEMORY_LIMIT="1536m"
MMH_NODE_MAX_OLD_SPACE_MB="auto"
PG_POOL_MAX="4"
MMH_UPDATE_SOURCE_URL="https://github.com/frankluise5220/MMH.git"
MMH_GIT_REMOTE="origin"
MMH_GIT_BRANCH="main"
MMH_COMPOSE_PROJECT="mmh"
# NAS host port. The container port stays 7777; change this when the host port is occupied.
MMH_HOST_PORT="7777"
MMH_IMAGE_SOURCE="dockerproxy"
MMH_APP_IMAGE="ghcr.dockerproxy.net/frankluise5220/mmh:latest"
MMH_UPDATER_IMAGE="ghcr.dockerproxy.net/frankluise5220/mmh-updater:latest"
# Optional central MMH registration service. Set both values to enable
# email-based MMH user registration in the first-ledger setup flow.
# The token is issued by the mmh-registration deployment and must not be committed.
MMH_REGISTRATION_API_URL="https://fnapp.floatingice.win:10101"
MMH_REGISTRATION_API_TOKEN=""
# 验证码邮件中继：MMH 不直连 Resend，改为把「收件邮箱 + 验证码 + 过期分钟数」
# 送到自有邮件服务器的专用接口，由其内部 Postfix 发信（发件人固定 mmh@floatingice.win）。
# 两个值都设置才启用；token 由中继服务签发，绝不传入密码或 SMTP 凭据。
MMH_MAIL_RELAY_URL="https://admin.floatingice.win"
MMH_MAIL_RELAY_TOKEN=""
CUSTOM_MMH_APP_IMAGE=""
CUSTOM_MMH_UPDATER_IMAGE=""
# 更新前快照：更新器会在拉取镜像前导出数据库快照（pg_dump），更新失败时把应用与数据库一起回滚到更新前状态。
# 只在宿主机确实无法导出快照（例如自定义数据库镜像没有 pg_dump）时才设为 1。
# 设为 1 后失败时只回滚应用、不回滚数据库，旧镜像可能被 schema 版本门拦下（容器退出码 78）。
# MMH_UPDATE_ALLOW_NO_SNAPSHOT="1"
PRISMA_CLIENT_ENGINE_TYPE="binary"
POSTGRES_IMAGE="postgres:15-alpine"
# 如果 NAS 无法访问 Docker Hub，改成可用的 PostgreSQL 镜像源，例如：
# POSTGRES_IMAGE="docker.m.daocloud.io/library/postgres:15-alpine"

# Project feedback-only Resend key. Only the feedback API reads this value.
# Leave empty unless you are deploying the project feedback fallback.
# MMH_FEEDBACK_RESEND_API_KEY=""
# MMH_FEEDBACK_RESEND_FROM="mmh@floatingice.win"

# Optional feedback relay override. Leave unset to use the built-in relay.
# MMH_FEEDBACK_RELAY_URL="https://feedback.floatingice.win/v1/feedback"
