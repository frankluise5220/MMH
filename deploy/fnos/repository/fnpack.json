  "apps": {
    "mmh": {
      "display_name": "MMH 家庭财务工作台",
      "desc": "MMH 家庭财务工作台是本地优先的家庭记账与全资产管理工具，数据保存在自己的飞牛 NAS 上。支持多账本、多成员、账户流水、往来款、信用卡、贷款、基金、股票、存款、债券、房产、保险、统计报表、导入导出、AI 助手以及手动/自动备份。报销与差旅工作流正在开发中，已提供部分录入和查看能力。",
      "platform": [
        "x86",
        "arm"
      ],
      "categories": [
        "生活服务"
      ],
      "icon_url": "https://raw.githubusercontent.com/frankluise5220/MMH/main/public/branding/mmh-logo-pageflip-192.png?v=0.1.69",
      "readme_url": "https://raw.githubusercontent.com/frankluise5220/MMH/main/README.md",
      "bug_report_url": "https://github.com/frankluise5220/MMH/issues",
      "maintainer": "frankluise5220",
      "maintainer_url": "https://github.com/frankluise5220/MMH",
      "run_as": "package",
      "install_type": "",
      "is_docker": false,
      "service_port": "7777",
      "i18n": {
        "en-US": {
          "display_name": "MMH Home Finance Workspace",
          "desc": "MMH is a local-first home bookkeeping and full asset-management workspace stored on your own Feiniu NAS. It supports multiple ledgers and members, transactions, settlements, credit cards, loans, funds, stocks, deposits, bonds, property, insurance, reports, imports, an AI assistant, and manual or automatic backups. Reimbursement and travel workflows are under development."
        },
        "ja-JP": {
          "display_name": "MMH ホームファイナンスワークスペース",
          "desc": "MMH は自分の Feiniu NAS にデータを保存するローカルファーストの家計・資産管理ワークスペースです。複数帳簿・複数メンバー、取引、立替・貸借、カード、ローン、投資信託、株式、預金、債券、不動産、保険、レポート、取込、AI アシスタント、手動 / 自動バックアップに対応します。精算・出張ワークフローは開発中です。"
        }
      },
