# 复制成 .env 后按实际环境修改：cp .env.example .env

# 两个容器共享的数据目录（fn-appstores.json / apps / downloads / icons / admin / mmh-stats.db）
DATA_DIR=/opt/mmh-fnstore/data

# 镜像
FNSTORE_GO_IMAGE=ccr.ccs.tencentyun.com/hhxs2025/fn-appstores-server:2.8.4
FNSTORE_PY_IMAGE=ccr.ccs.tencentyun.com/hhxs2025/fn-appstores-server:2.2.0

# 端口（5660 对外，5661 仅回环、由 nginx 反代）
FNSTORE_GO_PORT=5660
FNSTORE_PY_PORT=5661

# FN 软仓源的对外地址（Go 版用它拼应用/图标链接）
BASE_URL=http://fnapp.floatingice.win

# 群晖套件源的对外地址（Python 版用它拼 SPK 下载链接，必须能被 DSM 访问）
SYNOLOGY_BASE_URL=https://synology.floatingice.win
