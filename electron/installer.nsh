; MMH NSIS customization.
;
; Business logic:
;   1. Default install directory: D:\MMH when the D: drive exists, otherwise
;      Program Files (x64). Written into the registry key electron-builder reads
;      during .onInit to override the default INSTALL_ROOT.
;   2. **$INSTDIR\data is user property and is never touched.** The database lives
;      there (the user wants it next to the app so it is easy to back up).
;      Installation, upgrade and uninstall must not move, delete or rewrite it —
;      2026-10-28 a cross-volume `Rename` silently failed and the uninstaller's
;      `RMDir /r $INSTDIR` destroyed a real book that way. See the "用户数据" notes
;      on preInit / customInstall / customRemoveFiles below.
;
; Visual customization (2026-10-07): the welcome / finish pages are replaced
; with custom nsDialogs pages that draw a full-bleed dark brand background
; (installerWelcome.bmp / uninstallerWelcome.bmp, generated by
; scripts/generate-nsis-bitmaps.cjs) with light headline copy, instead of the
; stock grey-and-white MUI2 pages. This modernises the wizard without touching
; electron-builder's auto-update (NsisUpdater) or install/uninstall logic.
;
; The custom page structure mirrors electron-builder's own multiUserUi.nsh
; (PAGE_INSTALL_MODE): page content is built inside the Pre callback
; (nsDialogs::Create -> controls -> nsDialogs::Show), then wired via
; PageEx custom / UninstPage custom.

; nsDialogs is already included by MUI2; include again only so the ${NSD_*}
; macros resolve regardless of include order (redefining macros is harmless).
!include "nsDialogs.nsh"

; Shared handles. Declared once at top level so both the install and uninstall
; custom pages can use them without re-declaring (a duplicate Var is fatal).
Var mmhBgImage
Var mmhBgBitmap
Var mmhTitleFont

; Unpack + load the full-bleed background bitmap for a custom page.
!macro MMH_PAGE_BACKGROUND bmpName
  ${NSD_CreateBitmap} 0 0 100% 100% ""
  Pop $mmhBgImage
  ${NSD_SetStretchedImage} $mmhBgImage "$PLUGINSDIR\${bmpName}" $mmhBgBitmap
!macroend

; Create a light (white) label over the dark background, optionally bold.
!macro MMH_TITLE outVar x y w h text size
  ${NSD_CreateLabel} ${x}u ${y}u ${w}u ${h}u "${text}"
  Pop ${outVar}
  SetCtlColors ${outVar} 0xFFFFFF transparent
  CreateFont $mmhTitleFont "$(^Font)" "${size}" "700"
  SendMessage ${outVar} ${WM_SETFONT} $mmhTitleFont 0
!macroend

!macro MMH_TEXT outVar x y w h text
  ${NSD_CreateLabel} ${x}u ${y}u ${w}u ${h}u "${text}"
  Pop ${outVar}
  SetCtlColors ${outVar} 0xFFFFFF transparent
!macroend

; ------------------------------------------------------------------ Welcome

!macro customWelcomePage

  Var /GLOBAL mmhWelcomePage

  !insertmacro MUI_PAGE_INIT

  Function mmh.WelcomePre
    InitPluginsDir
    File /oname=$PLUGINSDIR\welcome.bmp "${BUILD_RESOURCES_DIR}\installerWelcome.bmp"

    nsDialogs::Create 1044
    Pop $mmhWelcomePage
    nsDialogs::SetRTL $(^RTL)

    !insertmacro MMH_PAGE_BACKGROUND welcome.bmp

    !insertmacro MMH_TITLE $0 300 22 700 40 "MMH 家庭财务工作台" 16
    !insertmacro MMH_TEXT $1 300 74 700 20 "本地优先的家庭记账与全资产管理"
    !insertmacro MMH_TEXT $2 300 100 700 60 "数据保存在你自己的设备上，支持多账本、多成员、账户流水、投资、存款、房产、统计报表与 AI 助手。$\r$\n点击「下一步」开始安装。"

    nsDialogs::Show
  FunctionEnd

  Function mmh.WelcomeLeave
  FunctionEnd

  PageEx custom
    PageCallbacks mmh.WelcomePre mmh.WelcomeLeave
  PageExEnd

!macroend

; ------------------------------------------------------------------ Finish

!macro customFinishPage

  Var /GLOBAL mmhFinishPage
  Var /GLOBAL mmhFinishLaunch
  Var /GLOBAL mmhLaunchArgs

  !insertmacro MUI_PAGE_INIT

  Function mmh.FinishPre
    InitPluginsDir
    File /oname=$PLUGINSDIR\welcome.bmp "${BUILD_RESOURCES_DIR}\installerWelcome.bmp"

    nsDialogs::Create 1044
    Pop $mmhFinishPage
    nsDialogs::SetRTL $(^RTL)

    !insertmacro MMH_PAGE_BACKGROUND welcome.bmp

    !insertmacro MMH_TITLE $0 300 22 700 40 "安装完成" 16
    !insertmacro MMH_TEXT $1 300 74 700 40 "MMH 已安装到你的设备，记账数据保存在本地。"

    ${NSD_CreateCheckbox} 300u 128u 700u 16u "立即启动 MMH"
    Pop $mmhFinishLaunch
    SetCtlColors $mmhFinishLaunch 0xFFFFFF transparent
    ${NSD_Check} $mmhFinishLaunch

    nsDialogs::Show
  FunctionEnd

  Function mmh.FinishLeave
    ${NSD_GetState} $mmhFinishLaunch $0
    ${if} $0 == ${BST_CHECKED}
      ; Launch the app. Inlined (rather than reusing the StartApp macro) so we
      ; don't depend on its `Var /GLOBAL startAppArgs` being declared exactly
      ; once; `$launchLink` and ${isUpdated} come from electron-builder.
      ${if} ${isUpdated}
        StrCpy $mmhLaunchArgs "--updated"
      ${else}
        StrCpy $mmhLaunchArgs ""
      ${endif}
      ${StdUtils.ExecShellAsUser} $0 "$launchLink" "open" "$mmhLaunchArgs"
    ${endif}
  FunctionEnd

  PageEx custom
    PageCallbacks mmh.FinishPre mmh.FinishLeave
  PageExEnd

!macroend

; ------------------------------------------------------------------ Uninstall welcome

!macro customUnWelcomePage

  Var /GLOBAL mmhUnWelcomePage

  !insertmacro MUI_UNPAGE_INIT

  Function un.mmh.UnWelcomePre
    InitPluginsDir
    File /oname=$PLUGINSDIR\welcome.bmp "${BUILD_RESOURCES_DIR}\uninstallerWelcome.bmp"

    nsDialogs::Create 1044
    Pop $mmhUnWelcomePage
    nsDialogs::SetRTL $(^RTL)

    !insertmacro MMH_PAGE_BACKGROUND welcome.bmp

    !insertmacro MMH_TITLE $0 300 22 700 40 "卸载 MMH" 16
    !insertmacro MMH_TEXT $1 300 74 700 40 "将从此设备移除 MMH。你的记账数据会保留在本地，重新安装后仍可继续使用。"

    nsDialogs::Show
  FunctionEnd

  Function un.mmh.UnWelcomeLeave
  FunctionEnd

  UninstPage custom un.mmh.UnWelcomePre un.mmh.UnWelcomeLeave

!macroend

; ------------------------------------------------------------------ Business logic

; Only decide the default install directory for a *first* installation, and never
; override an existing record.
;
; Why this matters (0.1.78 and earlier got it wrong):
;   preInit runs at the very top of .onInit (templates/nsis/installer.nsi:55),
;   *before* initMultiUser. initMultiUser decides per-user vs per-machine from
;   HKCU/HKLM InstallLocation, and per-machine is what triggers the UAC elevation
;   prompt. Unconditionally writing an HKCU record therefore made every install
;   look like "for current user only" => no elevation => the wizard then tried to
;   write into C:\Program Files\MMH without admin rights and NSIS aborted with
;   "Cannot open file for writing ...\MMH.exe".
;   Two more defects in the old version: `IfFileExists "D:\"` is always false for
;   a bare drive root (NSIS needs a wildcard), so the D: branch never ran; and
;   $PROGRAMFILES64 is not writable in a non-elevated per-user install.
!macro preInit
  ReadRegStr $0 HKCU "${INSTALL_REGISTRY_KEY}" InstallLocation
  StrCmp $0 "" mmhPreInitFirst mmhPreInitExisting

  mmhPreInitExisting:
  ; A previous version may have left an HKCU record pointing at Program Files.
  ; Heal it only when that path is not writable right now (i.e. not elevated),
  ; otherwise keep it untouched so upgrades stay in the same folder.
  StrCmp $0 "$PROGRAMFILES64\MMH" 0 mmhPreInitDone
  ClearErrors
  FileOpen $2 "$0\mmh-write-test.tmp" w
  IfErrors mmhPreInitHeal mmhPreInitWritable
  mmhPreInitWritable:
  FileClose $2
  Delete "$0\mmh-write-test.tmp"
  Goto mmhPreInitDone
  mmhPreInitHeal:
  WriteRegExpandStr HKCU "${INSTALL_REGISTRY_KEY}" InstallLocation "$LOCALAPPDATA\Programs\MMH"
  Goto mmhPreInitDone

  mmhPreInitFirst:
  ; A per-machine record lives in HKLM and makes the installer request elevation;
  ; in that case leave the registry alone so the wizard reads it back.
  ReadRegStr $1 HKLM "${INSTALL_REGISTRY_KEY}" InstallLocation
  StrCmp $1 "" 0 mmhPreInitDone
  IfFileExists "D:\*.*" 0 mmhPreInitLocalAppData
  WriteRegExpandStr HKCU "${INSTALL_REGISTRY_KEY}" InstallLocation "D:\MMH"
  Goto mmhPreInitDone
  mmhPreInitLocalAppData:
  WriteRegExpandStr HKCU "${INSTALL_REGISTRY_KEY}" InstallLocation "$LOCALAPPDATA\Programs\MMH"

  mmhPreInitDone:

  ; ---------------------------------------------------------------- 用户数据兜底
  ;
  ; 2026-10-28 事故：<= 0.1.79 的卸载器用
  ;   Rename "$INSTDIR\data" "$TEMP\MMH-data-backup"
  ; 备份数据目录。$INSTDIR 在 D:\MMH（D 盘）、$TEMP 在 C 盘，而 NSIS 的 Rename
  ; 底层是 MoveFile，**不能跨卷移动目录** —— 这一步静默失败（宏里也没有 IfErrors），
  ; data 留在原地，随后 electron-builder 的 `RMDir /r $INSTDIR` 把它连同整个安装
  ; 目录一起删掉，"移回" section 又因为备份不存在而跳过。用户的账簿就此消失。
  ;
  ; 升级时 electron-builder 是「先静默运行旧卸载器，再铺新文件」
  ; (installUtil.nsh:245 ExecWait '... /S /KEEP_APP_DATA ... /updated _?=<dir>')，
  ; 所以新安装器必须在 .onInit 最前面把现有数据复制到 $TEMP 兜住，装完再放回。
  ; 复制（而不是移动）本身跨卷安全，旧卸载器删的是原目录，TEMP 里的不受影响。
  ; 定位现有的数据目录。**不能只信注册表**：实测 0.1.78/0.1.79 的卸载记录里
  ; InstallLocation 是空的，只看它就会跳过备份、让旧卸载器把数据删掉。
  ; 注册表拿不到时按安装器的三个默认位置兜底。
  StrCpy $3 ""
  ReadRegStr $3 HKCU "${INSTALL_REGISTRY_KEY}" InstallLocation
  StrCmp $3 "" 0 mmhPreInitLocate
  ReadRegStr $3 HKLM "${INSTALL_REGISTRY_KEY}" InstallLocation
  mmhPreInitLocate:
  StrCmp $3 "" mmhPreInitTryD
  IfFileExists "$3\data\*.*" mmhPreInitBackup
  mmhPreInitTryD:
  IfFileExists "D:\MMH\data\*.*" 0 mmhPreInitTryLocal
  StrCpy $3 "D:\MMH"
  Goto mmhPreInitBackup
  mmhPreInitTryLocal:
  IfFileExists "$LOCALAPPDATA\Programs\MMH\data\*.*" 0 mmhPreInitTryPf
  StrCpy $3 "$LOCALAPPDATA\Programs\MMH"
  Goto mmhPreInitBackup
  mmhPreInitTryPf:
  IfFileExists "$PROGRAMFILES64\MMH\data\*.*" 0 mmhPreInitNoData
  StrCpy $3 "$PROGRAMFILES64\MMH"
  mmhPreInitBackup:
  RMDir /r "$TEMP\MMH-data-safe"
  nsExec::ExecToLog 'robocopy "$3\data" "$TEMP\MMH-data-safe" /E /NFL /NDL /NJH /NJS /R:1 /W:1'
  Pop $4
  DetailPrint "MMH: 已备份现有数据 $3\data -> $TEMP\MMH-data-safe (robocopy rc=$4)"
  mmhPreInitNoData:
!macroend

; 装完把 preInit 兜住的数据放回。只在新目录还没有 data 时恢复，避免覆盖。
!macro customInstall
  IfFileExists "$TEMP\MMH-data-safe\*.*" 0 mmhInstallNoData
  IfFileExists "$INSTDIR\data\*.*" mmhInstallNoData mmhInstallRestore
  mmhInstallRestore:
  nsExec::ExecToLog 'robocopy "$TEMP\MMH-data-safe" "$INSTDIR\data" /E /NFL /NDL /NJH /NJS /R:1 /W:1'
  Pop $4
  IfFileExists "$INSTDIR\data\*.*" 0 mmhInstallNoData
  RMDir /r "$TEMP\MMH-data-safe"
  DetailPrint "MMH: 用户数据已恢复到 $INSTDIR\data"
  mmhInstallNoData:
!macroend

; 接管 electron-builder 的文件清理（自定义宏优先于内置的
; un.atomicRMDir / `RMDir /r $INSTDIR` 两条分支，**升级和手动卸载都走这里**）。
;
; 契约：$INSTDIR\data 是用户资产，安装/卸载/升级永远不移动、不删除、不改写它。
; 其余条目逐个删除；如果还有删不掉的（MMH 正在运行），中止卸载而不是硬删。
!macro customRemoveFiles
  FindFirst $R7 $R8 "$INSTDIR\*.*"
  mmhRemoveLoop:
    StrCmp $R8 "" mmhRemoveDone
    StrCmp $R8 "." mmhRemoveNext
    StrCmp $R8 ".." mmhRemoveNext
    StrCmp $R8 "data" mmhRemoveNext
    RMDir /r "$INSTDIR\$R8"
    Delete "$INSTDIR\$R8"
    mmhRemoveNext:
      FindNext $R7 $R8
      Goto mmhRemoveLoop
  mmhRemoveDone:
    FindClose $R7

  ; 残留检查：被占用的文件 Delete 会静默失败，绝不能当作已删干净就继续。
  FindFirst $R7 $R8 "$INSTDIR\*.*"
  mmhRemoveVerifyLoop:
    StrCmp $R8 "" mmhRemoveVerifyDone
    StrCmp $R8 "." mmhRemoveVerifyNext
    StrCmp $R8 ".." mmhRemoveVerifyNext
    StrCmp $R8 "data" mmhRemoveVerifyNext
    IfFileExists "$INSTDIR\$R8" 0 mmhRemoveVerifyNext
    FindClose $R7
    MessageBox MB_OK|MB_ICONSTOP "无法删除：$INSTDIR\$R8$\r$\n请先退出 MMH（任务管理器结束 MMH.exe）后重新卸载。你的数据目录 data 不会被删除。" /SD IDOK
    Abort
    mmhRemoveVerifyNext:
      FindNext $R7 $R8
      Goto mmhRemoveVerifyLoop
  mmhRemoveVerifyDone:
    FindClose $R7

  ; 目录本身只在 data 不存在时才会空，否则保留（里面只剩 data）。
  RMDir "$INSTDIR"
!macroend
